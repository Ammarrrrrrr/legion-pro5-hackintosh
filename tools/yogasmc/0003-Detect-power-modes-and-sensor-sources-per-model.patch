     return ret;
 }
 
+IOReturn IdeaWMIGameZone::fanMethodCall(UInt32 method, UInt8 id, UInt32 *result) {
+    if (!YWMI->hasMethod(LENOVO_FAN_WMI_METHOD))
+        return kIOReturnUnsupported;
+
+    OSData *in = OSData::withBytes(&id, sizeof(id));
+    IOReturn ret = YWMI->evaluateInteger(LENOVO_FAN_WMI_METHOD, 0, method, result, in, true);
+    OSSafeReleaseNULL(in);
+    return ret;
+}
+
+IOReturn IdeaWMIGameZone::readSource(UInt8 source, UInt32 arg, UInt32 *result) {
+    switch (source) {
+        case LEGION_SOURCE_OTHER:
+            return getFeature(arg, result);
+        case LEGION_SOURCE_FAN:
+            return fanMethodCall(arg >> 8, arg & 0xff, result);
+        case LEGION_SOURCE_GAME_ZONE:
+            return gameZoneCall(arg, result);
+        default:
+            return kIOReturnUnsupported;
+    }
+}
+
+// LenovoLegionToolkit Compatibility.GetSupportedPowerModesAsync / GetSupportsExtremeMode
+void IdeaWMIGameZone::updateSupportedModes(UInt32 smartFanVersion) {
+    UInt32 bits = 0, legionZoneVersion = 0;
+    bool known = getFeature(LENOVO_CAP_SUPPORTED_MODES, &bits) == kIOReturnSuccess;
+    if (getFeature(LENOVO_CAP_LEGION_ZONE_VER, &legionZoneVersion) != kIOReturnSuccess)
+        legionZoneVersion = 0;
+
+    supportedModeCount = 0;
+    if (!known) {
+        // older Game Zone firmware: the three Fn+Q modes
+        supportedModes[supportedModeCount++] = LEGION_MODE_QUIET;
+        supportedModes[supportedModeCount++] = LEGION_MODE_BALANCED;
+        supportedModes[supportedModeCount++] = LEGION_MODE_PERFORMANCE;
+    } else {
+        if (bits & BIT(0))
+            supportedModes[supportedModeCount++] = LEGION_MODE_QUIET;
+        if (bits & BIT(1))
+            supportedModes[supportedModeCount++] = LEGION_MODE_BALANCED;
+        if (bits & BIT(2))
+            supportedModes[supportedModeCount++] = LEGION_MODE_PERFORMANCE;
+        if ((bits & BIT(4)) && ((smartFanVersion >= 6 && smartFanVersion <= 8) ||
+                                (legionZoneVersion >= 3 && legionZoneVersion <= 5)))
+            supportedModes[supportedModeCount++] = LEGION_MODE_EXTREME;
+        if (bits & BIT(16))
+            supportedModes[supportedModeCount++] = LEGION_MODE_CUSTOM;
+    }
+
+    OSArray *modes = OSArray::withCapacity(supportedModeCount);
+    if (modes) {
+        for (UInt8 i = 0; i < supportedModeCount; i++) {
+            OSNumber *num = OSNumber::withNumber(supportedModes[i], 32);
+            if (num) {
+                modes->setObject(num);
+                num->release();
+            }
+        }
+        setProperty("Legion Power Modes", modes);
+        modes->release();
+    }
+    if (known)
+        setProperty("SupportedPowerModes", bits, 32);
+}

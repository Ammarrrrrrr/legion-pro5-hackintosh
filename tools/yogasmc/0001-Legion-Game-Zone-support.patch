diff --git a/YogaSMCNC/LegionHelper.swift b/YogaSMCNC/LegionHelper.swift
new file mode 100644
index 0000000..75080a5
--- /dev/null
+++ b/YogaSMCNC/LegionHelper.swift
@@ -0,0 +1,140 @@
+//
+//  LegionHelper.swift
+//  YogaSMCNC
+//
+//  Legion Game Zone controls (power mode, sensors, toggles), modelled on LenovoLegionToolkit.
+//  Talks to the IdeaWMIGameZone instance published by YogaSMC and to IdeaVPC for battery/keyboard.
+//
+
+import AppKit
+import os.log
+
+class LegionHelper {
+    let gameZone: io_service_t
+    let vpc: io_service_t
+    let menu: NSMenu
+    let modeItem: NSMenuItem
+    let modeMenu = NSMenu()
+    let tempItem: NSMenuItem
+    let fanItem: NSMenuItem
+    var toggles: [(item: NSMenuItem, key: String, service: io_service_t)] = []
+
+    // LENOVO_GAMEZONE_DATA SetSmartFanMode values (LLT PowerModeState + 1)
+    static let modes: [(value: Int, name: String)] = [
+        (1, "Quiet"), (2, "Balanced"), (3, "Performance"), (255, "Custom")
+    ]
+
+    static func modeName(_ value: Int) -> String {
+        if value == 224 { return "Extreme" }
+        return modes.first { $0.value == value }?.name ?? "Unknown (\(value))"
+    }
+
+    init?(_ menu: NSMenu, _ vpc: io_service_t) {
+        let service = IOServiceGetMatchingService(kIOMasterPortDefault, IOServiceMatching("IdeaWMIGameZone"))
+        guard service != 0 else {
+            if #available(macOS 10.12, *) {
+                os_log("IdeaWMIGameZone not found, Legion menu disabled", type: .info)
+            }
+            return nil
+        }
+        gameZone = service
+        self.vpc = vpc
+        self.menu = menu
+
+        let caps = getDictionary("Legion Capabilities", gameZone) as? [String: Bool] ?? [:]
+
+        modeItem = NSMenuItem(title: "Power Mode", action: nil, keyEquivalent: "")
+        tempItem = NSMenuItem(title: "CPU –  GPU –", action: nil, keyEquivalent: "")
+        fanItem = NSMenuItem(title: "Fans –", action: nil, keyEquivalent: "")
+
+        var index = 0
+        func add(_ item: NSMenuItem) {
+            menu.insertItem(item, at: index)
+            index += 1
+        }
+
+        if caps["PowerMode"] == true {
+            for mode in LegionHelper.modes {
+                let item = NSMenuItem(title: mode.name, action: #selector(setMode(_:)), keyEquivalent: "")
+                item.tag = mode.value
+                item.target = self
+                modeMenu.addItem(item)
+            }
+            modeItem.submenu = modeMenu
+            add(modeItem)
+        }
+        add(tempItem)
+        add(fanItem)
+        add(NSMenuItem.separator())
+
+        func addToggle(_ title: String, _ key: String, _ service: io_service_t) {
+            let item = NSMenuItem(title: title, action: #selector(toggle(_:)), keyEquivalent: "")
+            item.target = self
+            item.tag = toggles.count
+            toggles.append((item, key, service))
+            add(item)
+        }
+
+        let vpcProps = getProperties(vpc) ?? [:]
+        if vpcProps["ConservationMode"] != nil { addToggle("Battery Conservation (80%)", "ConservationMode", vpc) }
+        if vpcProps["RapidChargeMode"] != nil { addToggle("Rapid Charge", "RapidChargeMode", vpc) }
+        if vpcProps["FnlockMode"] != nil { addToggle("Fn Lock", "FnlockMode", vpc) }
+        if vpcProps["AlwaysOnUSBMode"] != nil { addToggle("Always-on USB", "AlwaysOnUSBMode", vpc) }
+        if caps["TouchpadLock"] == true { addToggle("Touchpad Lock", "TouchpadLock", gameZone) }
+        if caps["WinKeyLock"] == true { addToggle("Disable Win (⌘) Key", "WinKeyLock", gameZone) }
+        if caps["OverDrive"] == true { addToggle("Display Overdrive", "OverDrive", gameZone) }
+        add(NSMenuItem.separator())
+
+        update()
+    }
+
+    deinit {
+        IOObjectRelease(gameZone)
+    }
+
+    func update() {
+        _ = sendBoolean("UpdateSensors", true, gameZone)
+        _ = sendBoolean("Update", true, gameZone)
+
+        let mode = getNumber("PowerMode", gameZone)
+        if mode >= 0 {
+            modeItem.title = "Power Mode: \(LegionHelper.modeName(mode))"
+            for item in modeMenu.items {
+                item.state = item.tag == mode ? .on : .off
+            }
+        }
+
+        let sensors = getDictionary("Legion Sensors", gameZone) as? [String: Int] ?? [:]
+        var temps: [String] = []
+        if let cpu = sensors["CPU Temperature"] { temps.append("CPU \(cpu)°C") }
+        if let gpu = sensors["GPU Temperature"] { temps.append("GPU \(gpu)°C") }
+        if let pch = sensors["PCH Temperature"] { temps.append("PCH \(pch)°C") }
+        tempItem.title = temps.isEmpty ? "Temperatures unavailable" : temps.joined(separator: "  ")
+
+        var fans: [String] = []
+        if let cpu = sensors["CPU Fan"] { fans.append("CPU \(cpu)") }
+        if let gpu = sensors["GPU Fan"] { fans.append("GPU \(gpu)") }
+        fanItem.title = fans.isEmpty ? "Fan speed unavailable" : "Fans " + fans.joined(separator: "  ") + " rpm"
+
+        for entry in toggles {
+            entry.item.state = getBoolean(entry.key, entry.service) ? .on : .off
+        }
+    }
+
+    @objc func setMode(_ sender: NSMenuItem) {
+        if !sendNumber("PowerMode", sender.tag, gameZone) {
+            showOSDRaw("Power mode change failed")
+        }
+        update()
+    }
+
+    @objc func toggle(_ sender: NSMenuItem) {
+        guard sender.tag < toggles.count else { return }
+        let entry = toggles[sender.tag]
+        let target = entry.item.state != .on
+        if !sendBoolean(entry.key, target, entry.service) {
+            showOSDRaw("\(entry.item.title) failed")
+        }
+        update()
+    }
+}

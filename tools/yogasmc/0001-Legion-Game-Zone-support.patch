+bool IdeaWMIGameZone::readSensor(UInt32 sensor, UInt32 *value) {
+    if (sensor >= LEGION_SENSOR_COUNT || !sensorSource[sensor])
+        return false;
+
+    UInt32 result = 0;
+    IOReturn ret = sensorFromOther[sensor] ? getFeature(sensorSource[sensor], &result)
+                                           : gameZoneCall(sensorSource[sensor], &result);
+    if (ret != kIOReturnSuccess || !plausible(sensor, result))
+        return false;
+
+    *value = result;
+    return true;
+}
+
+bool IdeaWMIGameZone::publishState(const char *key, UInt32 method, bool asBoolean) {
+    UInt32 value;
+    if (gameZoneCall(method, &value) != kIOReturnSuccess) {
+        removeProperty(key);
+        return false;
+    }
+
+    if (asBoolean)
+        setProperty(key, value != 0);
     else
-        AlwaysLog("message: Unknown ACPI notification 0x%04x", argument);
+        setProperty(key, value, 32);
+    return true;
+}
+
+void IdeaWMIGameZone::updatePowerMode(bool notify) {
+    UInt32 mode;
+    if (!smartFanCap || gameZoneCall(GAME_ZONE_WMI_GET_SMARTFAN_MODE, &mode) != kIOReturnSuccess)
+        return;
+
+    setProperty("PowerMode", mode, 32);
+    setProperty("PowerModeName", powerModeName(mode));
+    if (notify)
+        notifyLegion(LEGION_EVENT_POWER_MODE, mode);
+}
+
+void IdeaWMIGameZone::updateLegion() {
+    updatePowerMode(false);
+    publishState("ThermalMode", GAME_ZONE_WMI_GET_THERMAL_MODE, false);
+    publishState("PowerChargeMode", GAME_ZONE_WMI_GET_CHARGE_MODE, false);
+    if (touchpadCap)
+        publishState("TouchpadLock", GAME_ZONE_WMI_GET_TOUCHPAD, true);
+    if (winKeyCap)
+        publishState("WinKeyLock", GAME_ZONE_WMI_GET_WIN_KEY, true);
+    if (overDriveCap)
+        publishState("OverDrive", GAME_ZONE_WMI_GET_OVER_DRIVE, true);
+    if (iGPUModeCap)
+        publishState("IGPUMode", GAME_ZONE_WMI_GET_IGPU_MODE, false);
+}
+
+void IdeaWMIGameZone::notifyLegion(UInt32 event, UInt32 data) {
+    LegionEventMessage msg {event, data};
+    dispatchMessage(kSMC_LegionEvent, &msg);
+}
+
+void IdeaWMIGameZone::setPowerMode(UInt32 mode) {
+    if (!smartFanCap) {
+        AlwaysLog(notSupported, "PowerMode");
+        return;
+    }
+
+    switch (mode) {
+        case LEGION_MODE_QUIET:
+        case LEGION_MODE_BALANCED:
+        case LEGION_MODE_PERFORMANCE:
+        case LEGION_MODE_EXTREME:
+        case LEGION_MODE_CUSTOM:
+            break;
+        default:
+            AlwaysLog(valueInvalid, "PowerMode");
+            return;
+    }
+
+    OSNumber *in = OSNumber::withNumber(mode, 32);
+    IOReturn ret = YWMI->evaluateMethod(GAME_ZONE_DATA_WMI_METHOD, 0, GAME_ZONE_WMI_SET_SMARTFAN_MODE, nullptr, in, true);
+    OSSafeReleaseNULL(in);
+
+    setProperty("PowerModeSetResult", ret, 32);
+    if (ret != kIOReturnSuccess)
+        AlwaysLog(toggleError, "PowerMode", ret);
+    updatePowerMode(true);
+}
+
+void IdeaWMIGameZone::setToggle(const char *key, UInt32 setMethod, UInt32 getMethod, bool enable) {
+    OSNumber *in = OSNumber::withNumber(enable ? 1 : 0, 32);
+    IOReturn ret = YWMI->evaluateMethod(GAME_ZONE_DATA_WMI_METHOD, 0, setMethod, nullptr, in, true);
+    OSSafeReleaseNULL(in);
+
+    if (ret != kIOReturnSuccess)
+        AlwaysLog(toggleError, key, ret);
+    publishState(key, getMethod, true);
+}
+
+void IdeaWMIGameZone::ACPIEvent(UInt32 argument) {
+    OSObject *result = nullptr;
+    UInt32 data = 0;
+    if (YWMI->getEventData(argument, &result)) {
+        if (OSNumber *num = OSDynamicCast(OSNumber, result))
+            data = num->unsigned32BitValue();
+        else if (OSData *buf = OSDynamicCast(OSData, result))
+            if (buf->getLength() >= sizeof(data))
+                memcpy(&data, buf->getBytesNoCopy(), sizeof(data));
+    }
     OSSafeReleaseNULL(result);
+
+    UInt32 last[2] = {argument, data};
+    setProperty("LastEvent", last, sizeof(last));
+    DebugLog("message: ACPI notification 0x%04x - 0x%04x", argument, data);
+
+    if (smartFanEvent && argument == smartFanEvent) {
+        updatePowerMode(true);
+    } else if (thermalEvent && argument == thermalEvent) {
+        publishState("ThermalMode", GAME_ZONE_WMI_GET_THERMAL_MODE, false);
+        notifyLegion(LEGION_EVENT_THERMAL_MODE, data);
+    } else if (argument == keyEvent) {
+        updateLegion();
+        notifyLegion(LEGION_EVENT_KEY_LOCK, data);
+    } else if (chargeEvent && argument == chargeEvent) {
+        publishState("PowerChargeMode", GAME_ZONE_WMI_GET_CHARGE_MODE, false);
+        notifyLegion(LEGION_EVENT_CHARGE_MODE, data);
+    } else if (lightEvent && argument == lightEvent) {
+        notifyLegion(LEGION_EVENT_LIGHT, data);
+    } else if (fanSettingEvent && argument == fanSettingEvent) {
+        notifyLegion(LEGION_EVENT_FAN_SETTING, data);
+    }
 }
 

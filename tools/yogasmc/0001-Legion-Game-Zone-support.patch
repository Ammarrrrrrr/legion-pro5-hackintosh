+        } else if (gzOk) {
+            sensorSource[src.sensor] = src.gameZone;
+            sensorFromOther[src.sensor] = false;
+            snprintf(desc, sizeof(desc), "GameZone %u (%u)", src.gameZone, gzValue);
+        } else {
+            snprintf(desc, sizeof(desc), "unavailable");
+        }
+
+        if (status) {
+            OSString *str = OSString::withCString(desc);
+            if (str) {
+                status->setObject(legionSensorName[src.sensor], str);
+                str->release();
+            }
+        }
+    }
+
+    if (status) {
+        setProperty("Legion Sensor Source", status);
+        status->release();
+    }
+}

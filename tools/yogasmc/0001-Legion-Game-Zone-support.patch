+IOReturn IdeaWMIGameZone::setProperties(OSObject *props) {
+    commandGate->runAction(OSMemberFunctionCast(IOCommandGate::Action, this, &IdeaWMIGameZone::setPropertiesGated), props);
+    return kIOReturnSuccess;
+}
+
+void IdeaWMIGameZone::setPropertiesGated(OSObject *props) {
+    OSDictionary *dict = OSDynamicCast(OSDictionary, props);
+    if (!dict)
+        return;
+
+    OSCollectionIterator *i = OSCollectionIterator::withCollection(dict);
+    if (!i)
+        return;
+
+    while (OSString *key = OSDynamicCast(OSString, i->getNextObject())) {
+        OSObject *obj = dict->getObject(key);
+        if (key->isEqualTo("PowerMode")) {
+            if (OSNumber *num = OSDynamicCast(OSNumber, obj)) {
+                setPowerMode(num->unsigned32BitValue());
+            } else if (OSString *str = OSDynamicCast(OSString, obj)) {
+                static const UInt32 modes[] = {LEGION_MODE_QUIET, LEGION_MODE_BALANCED, LEGION_MODE_PERFORMANCE,
+                                               LEGION_MODE_EXTREME, LEGION_MODE_CUSTOM};
+                for (UInt32 mode : modes)
+                    if (str->isEqualTo(powerModeName(mode)))
+                        setPowerMode(mode);
+            } else {
+                AlwaysLog(valueInvalid, "PowerMode");
+            }
+        } else if (key->isEqualTo("TouchpadLock") || key->isEqualTo("WinKeyLock") || key->isEqualTo("OverDrive")) {
+            OSBoolean *value = OSDynamicCast(OSBoolean, obj);
+            if (!value) {
+                AlwaysLog(valueInvalid, key->getCStringNoCopy());
+            } else if (key->isEqualTo("TouchpadLock") && touchpadCap) {
+                setToggle("TouchpadLock", GAME_ZONE_WMI_SET_TOUCHPAD, GAME_ZONE_WMI_GET_TOUCHPAD, value->getValue());
+            } else if (key->isEqualTo("WinKeyLock") && winKeyCap) {
+                setToggle("WinKeyLock", GAME_ZONE_WMI_SET_WIN_KEY, GAME_ZONE_WMI_GET_WIN_KEY, value->getValue());
+            } else if (key->isEqualTo("OverDrive") && overDriveCap) {
+                setToggle("OverDrive", GAME_ZONE_WMI_SET_OVER_DRIVE, GAME_ZONE_WMI_GET_OVER_DRIVE, value->getValue());
+            } else {
+                AlwaysLog(notSupported, key->getCStringNoCopy());
+            }
+        } else if (key->isEqualTo("Update")) {
+            updateLegion();
+        } else if (key->isEqualTo("UpdateSensors")) {
+            OSDictionary *values = OSDictionary::withCapacity(LEGION_SENSOR_COUNT);
+            if (values) {
+                for (UInt32 sensor = 0; sensor < LEGION_SENSOR_COUNT; sensor++) {
+                    UInt32 value;
+                    if (readSensor(sensor, &value)) {
+                        OSNumber *num = OSNumber::withNumber(value, 32);
+                        if (num) {
+                            values->setObject(legionSensorName[sensor], num);
+                            num->release();
+                        }
+                    }
+                }
+                setProperty("Legion Sensors", values);
+                values->release();
+            }
+        } else if (key->isEqualTo("WMIQuery")) {
+            if (OSDictionary *req = OSDynamicCast(OSDictionary, obj))
+                wmiQuery(req);
+        } else if (key->isEqualTo("WMIBlock")) {
+            if (OSDictionary *req = OSDynamicCast(OSDictionary, obj))
+                wmiBlock(req);
+        } else if (key->isEqualTo("ProbeAll")) {
+            OSDictionary *probe = OSDictionary::withCapacity(96);
+            if (!probe)
+                continue;
+            char name[64];
+            for (auto &m : gameZoneReadMethods) {
+                UInt32 value = 0;
+                IOReturn ret = gameZoneCall(m.id, &value);
+                snprintf(name, sizeof(name), "GZ %02u %s", m.id, m.name);
+                OSObject *res;
+                if (ret == kIOReturnSuccess) {
+                    res = OSNumber::withNumber(value, 32);
+                } else {
+                    char err[24];
+                    snprintf(err, sizeof(err), "error 0x%x", ret);
+                    res = OSString::withCString(err);
+                }
+                if (res) {
+                    probe->setObject(name, res);
+                    res->release();
+                }
+            }
+            for (auto &c : otherCapabilities) {
+                UInt32 value = 0;
+                IOReturn ret = getFeature(c.id, &value);
+                snprintf(name, sizeof(name), "OT %08x %s", c.id, c.name);
+                OSObject *res;
+                if (ret == kIOReturnSuccess) {
+                    res = OSNumber::withNumber(value, 32);
+                } else {
+                    char err[24];
+                    snprintf(err, sizeof(err), "error 0x%x", ret);
+                    res = OSString::withCString(err);
+                }
+                if (res) {
+                    probe->setObject(name, res);
+                    res->release();
+                }
+            }
+            setProperty("Legion Probe", probe);
+            probe->release();
+        } else if (key->isEqualTo("DumpACPI")) {
+            dumpACPI(obj);
+        } else {
+            AlwaysLog("Unknown property %s", key->getCStringNoCopy());
+        }
+    }
+    i->release();
+}

+// WMIQuery = {GUID: "gamezone"|"other"|"lighting"|"fan"|<guid>, Method: n, Arg: number|data (optional), NoArg: bool}
+void IdeaWMIGameZone::wmiQuery(OSDictionary *request) {
+    OSString *guidName = OSDynamicCast(OSString, request->getObject("GUID"));
+    OSNumber *method = OSDynamicCast(OSNumber, request->getObject("Method"));
+    OSObject *arg = request->getObject("Arg");
+    OSBoolean *noArg = OSDynamicCast(OSBoolean, request->getObject("NoArg"));
+
+    OSDictionary *res = OSDictionary::withCapacity(6);
+    if (!res)
+        return;
+
+    enum { kGameZone, kOther, kLighting, kFan, kInvalid } iface = kGameZone;
+    if (guidName) {
+        if (guidName->isEqualTo("other") || guidName->isEqualTo(LENOVO_OTHER_WMI_METHOD))
+            iface = kOther;
+        else if (guidName->isEqualTo("lighting") || guidName->isEqualTo(LENOVO_LIGHTING_WMI_METHOD))
+            iface = kLighting;
+        else if (guidName->isEqualTo("fan") || guidName->isEqualTo(LENOVO_FAN_WMI_METHOD))
+            iface = kFan;
+        else if (!guidName->isEqualTo("gamezone") && !guidName->isEqualTo(GAME_ZONE_DATA_WMI_METHOD))
+            iface = kInvalid;
+    }
+
+    // Only methods that read state are allowed here
+    bool allowed = false;
+    const char *guid = nullptr;
+    UInt32 id = method ? method->unsigned32BitValue() : 0;
+    switch (iface) {
+        case kGameZone:
+            guid = GAME_ZONE_DATA_WMI_METHOD;
+            for (auto &m : gameZoneReadMethods)
+                if (m.id == id)
+                    allowed = true;
+            break;
+        case kOther:
+            guid = LENOVO_OTHER_WMI_METHOD;
+            allowed = (id == LENOVO_OTHER_GET_FEATURE || id == LENOVO_OTHER_GET_COMMAND);
+            break;
+        case kLighting:
+            guid = LENOVO_LIGHTING_WMI_METHOD;
+            allowed = (id == 1); // Get_Lighting_Current_Status
+            break;
+        case kFan:
+            guid = LENOVO_FAN_WMI_METHOD;
+            allowed = (id == 5); // Fan_Get_Table
+            break;
+        default:
+            break;
+    }
+
+    OSString *g = OSString::withCString(guid ? guid : "invalid");
+    if (g) {
+        res->setObject("GUID", g);
+        g->release();
+    }
+    if (method)
+        res->setObject("Method", method);
+
+    if (!allowed || !method) {
+        OSString *s = OSString::withCString("not allowed (read-only methods only)");
+        if (s) {
+            res->setObject("Error", s);
+            s->release();
+        }
+    } else {
+        OSObject *input = nullptr;
+        bool owned = false;
+        if (noArg && noArg->getValue()) {
+            input = nullptr;
+        } else if (arg && (OSDynamicCast(OSNumber, arg) || OSDynamicCast(OSData, arg))) {
+            input = arg;
+        } else {
+            input = OSNumber::withNumber(0ULL, 32);
+            owned = true;
+        }
+
+        OSObject *out = nullptr;
+        IOReturn ret = YWMI->evaluateMethod(guid, 0, id, &out, input, true);
+        if (owned)
+            OSSafeReleaseNULL(input);
+
+        OSNumber *status = OSNumber::withNumber(ret, 32);
+        if (status) {
+            res->setObject("Status", status);
+            status->release();
+        }
+        if (out) {
+            const char *type = OSDynamicCast(OSNumber, out) ? "number" :
+                               OSDynamicCast(OSData, out) ? "data" :
+                               OSDynamicCast(OSString, out) ? "string" :
+                               OSDynamicCast(OSArray, out) ? "package" : "other";
+            OSString *t = OSString::withCString(type);
+            if (t) {
+                res->setObject("Type", t);
+                t->release();
+            }
+            res->setObject("Value", out);
+            out->release();
+        }
+    }
+
+    setProperty("WMIQueryResult", res);
+    res->release();
+}
+
+// WMIBlock = {GUID: <data block guid>, Instance: n}
+void IdeaWMIGameZone::wmiBlock(OSDictionary *request) {
+    OSString *guid = OSDynamicCast(OSString, request->getObject("GUID"));
+    OSNumber *instance = OSDynamicCast(OSNumber, request->getObject("Instance"));
+
+    OSDictionary *res = OSDictionary::withCapacity(4);
+    if (!res || !guid) {
+        OSSafeReleaseNULL(res);
+        return;
+    }
+    res->setObject("GUID", guid);
+    if (instance)
+        res->setObject("Instance", instance);
+
+    OSObject *out = nullptr;
+    IOReturn ret = YWMI->queryBlock(guid->getCStringNoCopy(), instance ? instance->unsigned8BitValue() : 0, &out, true);
+    OSNumber *status = OSNumber::withNumber(ret, 32);
+    if (status) {
+        res->setObject("Status", status);
+        status->release();
+    }
+    if (out) {
+        res->setObject("Value", out);
+        out->release();
+    }
+    setProperty("WMIBlockResult", res);
+    res->release();
+}
+
+// DumpACPI = "DSDT" | "SSDT" | {Table: "SSDT", Instance: n} | "clear"
+void IdeaWMIGameZone::dumpACPI(OSObject *request) {
+    char table[5] = "DSDT";
+    UInt32 instance = 0;
+
+    if (OSString *str = OSDynamicCast(OSString, request)) {
+        if (str->isEqualTo("clear")) {
+            removeProperty("ACPITable");
+            removeProperty("ACPITableName");
+            return;
+        }
+        strlcpy(table, str->getCStringNoCopy(), sizeof(table));
+    } else if (OSDictionary *dict = OSDynamicCast(OSDictionary, request)) {
+        if (OSString *name = OSDynamicCast(OSString, dict->getObject("Table")))
+            strlcpy(table, name->getCStringNoCopy(), sizeof(table));
+        if (OSNumber *num = OSDynamicCast(OSNumber, dict->getObject("Instance")))
+            instance = num->unsigned32BitValue();
+    }
+
+    char desc[32];
+    // the returned object is owned by the platform expert (see NootedRed), only copy it
+    const OSData *data = YWMI->getACPIDevice()->getACPITableData(table, instance);
+    if (!data) {
+        snprintf(desc, sizeof(desc), "%s %u not found", table, instance);
+        removeProperty("ACPITable");
+    } else {
+        OSData *copy = OSData::withData(data);
+        if (copy) {
+            setProperty("ACPITable", copy);
+            copy->release();
+        }
+        snprintf(desc, sizeof(desc), "%s %u (%u bytes)", table, instance, data->getLength());
+    }
+    setProperty("ACPITableName", desc);
+}

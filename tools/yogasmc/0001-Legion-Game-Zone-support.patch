+        {LEGION_SENSOR_GPU_FAN,  LENOVO_CAP_GPU_FAN_SPEED, GAME_ZONE_WMI_GET_FAN_TWO},
+        {LEGION_SENSOR_CPU_TEMP, LENOVO_CAP_CPU_TEMP,      GAME_ZONE_WMI_GET_TMP_CPU},
+        {LEGION_SENSOR_GPU_TEMP, LENOVO_CAP_GPU_TEMP,      GAME_ZONE_WMI_GET_TMP_GPU},
+        {LEGION_SENSOR_PCH_TEMP, LENOVO_CAP_PCH_TEMP,      0},
+        {LEGION_SENSOR_IR_TEMP,  0,                        GAME_ZONE_WMI_GET_TMP_IR},

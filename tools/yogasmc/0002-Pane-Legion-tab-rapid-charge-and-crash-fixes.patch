diff --git a/YogaSMCPane/LegionSMCPane.swift b/YogaSMCPane/LegionSMCPane.swift
new file mode 100644
index 0000000..28b549e
--- /dev/null
+++ b/YogaSMCPane/LegionSMCPane.swift
@@ -0,0 +1,223 @@
+//
+//  LegionSMCPane.swift
+//  YogaSMCPane
+//
+//  Legion tab (power mode, sensors, Game Zone toggles), built in code so the
+//  compiled 1.5.3 nib can be reused. Talks to the IdeaWMIGameZone instance.
+//
+
+import AppKit
+import IOKit
+
+class LegionPaneController: NSObject {
+    let gameZone: io_service_t
+    let tabItem = NSTabViewItem(identifier: "Legion")
+    let modeControl = NSSegmentedControl()
+    var sensorLabels: [String: NSTextField] = [:]
+    var toggles: [(button: NSButton, key: String)] = []
+    var timer: Timer?
+
+    // LENOVO_GAMEZONE_DATA SetSmartFanMode values (LenovoLegionToolkit PowerModeState + 1)
+    static let modes: [(value: Int, name: String)] = [
+        (1, "Quiet"), (2, "Balanced"), (3, "Performance"), (255, "Custom")
+    ]
+
+    static let sensors: [(key: String, title: String, unit: String)] = [
+        ("CPU Temperature", "CPU", "°C"),
+        ("GPU Temperature", "GPU", "°C"),
+        ("PCH Temperature", "Chipset", "°C"),
+        ("CPU Fan", "CPU fan", " rpm"),
+        ("GPU Fan", "GPU fan", " rpm")
+    ]
+
+    static let toggleList: [(key: String, title: String, note: String?)] = [
+        ("TouchpadLock", "Touchpad Lock", nil),
+        ("WinKeyLock", "Disable Win (⌘) Key", "Also disables Command, the Windows key on macOS."),
+        ("OverDrive", "Display Overdrive", nil)
+    ]
+
+    static func create() -> LegionPaneController? {
+        let service = IOServiceGetMatchingService(kIOMasterPortDefault, IOServiceMatching("IdeaWMIGameZone"))
+        guard service != 0 else { return nil }
+        return LegionPaneController(service)
+    }
+
+    init(_ service: io_service_t) {
+        gameZone = service
+        super.init()
+        tabItem.label = "Legion"
+        tabItem.view = buildView()
+        update()
+    }
+
+    deinit {
+        stop()
+        IOObjectRelease(gameZone)
+    }
+
+    // MARK: - Layout
+
+    private func header(_ title: String) -> NSTextField {
+        let label = NSTextField(labelWithString: title)
+        label.font = NSFont.boldSystemFont(ofSize: NSFont.systemFontSize)
+        return label
+    }
+
+    private func note(_ text: String) -> NSTextField {
+        let label = NSTextField(wrappingLabelWithString: text)
+        label.font = NSFont.systemFont(ofSize: NSFont.smallSystemFontSize)
+        label.textColor = .secondaryLabelColor
+        label.preferredMaxLayoutWidth = 280
+        return label
+    }
+
+    private func buildView() -> NSView {
+        let caps = getDictionary("Legion Capabilities", gameZone) as? [String: Bool] ?? [:]
+        let root = NSView(frame: NSRect(x: 0, y: 0, width: 622, height: 306))
+
+        // Left column: power mode and toggles
+        let left = NSStackView()
+        left.orientation = .vertical
+        left.alignment = .leading
+        left.spacing = 8
+
+        left.addArrangedSubview(header("Power Mode"))
+        modeControl.segmentCount = LegionPaneController.modes.count
+        for (index, mode) in LegionPaneController.modes.enumerated() {
+            modeControl.setLabel(mode.name, forSegment: index)
+            modeControl.setWidth(0, forSegment: index)
+        }
+        modeControl.trackingMode = .selectOne
+        modeControl.target = self
+        modeControl.action = #selector(modeChanged(_:))
+        modeControl.isEnabled = caps["PowerMode"] == true
+        left.addArrangedSubview(modeControl)
+        left.addArrangedSubview(note("Same setting as Fn+Q. Custom uses the custom profile stored in the BIOS."))
+        left.setCustomSpacing(18, after: left.arrangedSubviews.last!)
+
+        left.addArrangedSubview(header("Keyboard & Touchpad"))
+        var anyToggle = false
+        for entry in LegionPaneController.toggleList where caps[entry.key] == true {
+            let button = NSButton(checkboxWithTitle: entry.title, target: self, action: #selector(toggled(_:)))
+            button.tag = toggles.count
+            toggles.append((button, entry.key))
+            left.addArrangedSubview(button)
+            if let text = entry.note {
+                left.addArrangedSubview(note(text))
+            }
+            anyToggle = true
+        }
+        if !anyToggle {
+            left.addArrangedSubview(note("Not supported by this BIOS."))
+        }
+        left.setCustomSpacing(18, after: left.arrangedSubviews.last!)
+        left.addArrangedSubview(note("Battery conservation, rapid charge, Fn lock and always-on USB are on the Idea tab."))
+
+        // Right column: sensors
+        let grid = NSGridView(numberOfColumns: 2, rows: 0)
+        grid.rowSpacing = 8
+        grid.columnSpacing = 24
+        for sensor in LegionPaneController.sensors {
+            let value = NSTextField(labelWithString: "–")
+            value.alignment = .right
+            value.font = NSFont.monospacedDigitSystemFont(ofSize: NSFont.systemFontSize, weight: .regular)
+            sensorLabels[sensor.key] = value
+            grid.addRow(with: [NSTextField(labelWithString: sensor.title), value])
+        }
+        grid.column(at: 1).xPlacement = .trailing
+        grid.setContentHuggingPriority(.required, for: .vertical)
+
+        let right = NSStackView()
+        right.orientation = .vertical
+        right.alignment = .leading
+        right.spacing = 8
+        right.addArrangedSubview(header("Sensors"))
+        right.addArrangedSubview(grid)
+        let sensorNote = note("Read from the EC through LENOVO_OTHER_METHOD, refreshed every 2 seconds while this tab is open. Also published as SMC keys for monitoring apps.")
+        sensorNote.preferredMaxLayoutWidth = 230
+        right.addArrangedSubview(sensorNote)
+        right.setHuggingPriority(.required, for: .vertical)
+
+        let columns = NSStackView(views: [left, right])
+        columns.orientation = .horizontal
+        columns.alignment = .top
+        columns.spacing = 40
+        columns.translatesAutoresizingMaskIntoConstraints = false
+        root.addSubview(columns)
+        NSLayoutConstraint.activate([
+            columns.leadingAnchor.constraint(equalTo: root.leadingAnchor, constant: 24),
+            columns.topAnchor.constraint(equalTo: root.topAnchor, constant: 20),
+            columns.trailingAnchor.constraint(lessThanOrEqualTo: root.trailingAnchor, constant: -24),
+            left.widthAnchor.constraint(equalToConstant: 290),
+            right.widthAnchor.constraint(equalToConstant: 230),
+            grid.widthAnchor.constraint(equalTo: right.widthAnchor)
+        ])
+        return root
+    }
+
+    // MARK: - State
+
+    func start() {
+        update()
+        guard timer == nil else { return }
+        timer = Timer.scheduledTimer(withTimeInterval: 2, repeats: true) { [weak self] _ in
+            self?.update()
+        }
+    }
+
+    func stop() {
+        timer?.invalidate()
+        timer = nil
+    }
+
+    func update() {
+        _ = sendBoolean("UpdateSensors", true, gameZone)
+        _ = sendBoolean("Update", true, gameZone)
+
+        let mode = getNumber("PowerMode", gameZone)
+        if let index = LegionPaneController.modes.firstIndex(where: { $0.value == mode }) {
+            modeControl.selectedSegment = index
+        } else {
+            modeControl.selectedSegment = -1
+        }
+
+        let values = getDictionary("Legion Sensors", gameZone) as? [String: Int] ?? [:]
+        for sensor in LegionPaneController.sensors {
+            if let value = values[sensor.key] {
+                sensorLabels[sensor.key]?.stringValue = "\(value)\(sensor.unit)"
+            } else {
+                sensorLabels[sensor.key]?.stringValue = "–"
+            }
+        }
+
+        for entry in toggles {
+            entry.button.state = getBoolean(entry.key, gameZone) ? .on : .off
+        }
+    }
+
+    @objc func modeChanged(_ sender: NSSegmentedControl) {
+        let index = sender.selectedSegment
+        guard index >= 0, index < LegionPaneController.modes.count else { return }
+        _ = sendNumber("PowerMode", LegionPaneController.modes[index].value, gameZone)
+        update()
+    }
+
+    @objc func toggled(_ sender: NSButton) {
+        guard sender.tag < toggles.count else { return }
+        _ = sendBoolean(toggles[sender.tag].key, sender.state == .on, gameZone)
+        update()
+    }
+}
+
+extension YogaSMCPane {
+    func updateLegion() {
+        if legionController == nil {
+            legionController = LegionPaneController.create()
+        }
+        guard let controller = legionController else { return }
+        if mainTabView.indexOfTabViewItem(controller.tabItem) == NSNotFound {
+            mainTabView.addTabViewItem(controller.tabItem)
+        }
+        controller.start()
+    }
+}

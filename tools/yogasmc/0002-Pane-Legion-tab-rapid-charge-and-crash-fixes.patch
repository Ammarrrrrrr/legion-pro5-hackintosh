diff --git a/Tools/build-pane.sh b/Tools/build-pane.sh
new file mode 100755
index 0000000..46a4bb9
--- /dev/null
+++ b/Tools/build-pane.sh
@@ -0,0 +1,53 @@
+#!/bin/bash
+# Builds YogaSMCPane.prefPane with the Command Line Tools only (no Xcode).
+# swiftc builds the Swift sources as an MH_BUNDLE; the compiled YogaSMCPane.nib is reused from
+# the upstream 1.5.3 release (its outlets match the current xib; ibtool ships only with Xcode).
+# The Legion tab is built in code (YogaSMCPane/LegionSMCPane.swift).
+#
+# Usage: Tools/build-pane.sh [version] [upstream 1.5.3 YogaSMCPane.prefPane] [output dir]
+set -euo pipefail
+ROOT=$(cd "$(dirname "$0")/.." && pwd)
+VER=${1:-1.6.0}
+UPSTREAM=${2:-$ROOT/build/upstream-1.5.3/YogaSMCPane.prefPane}
+OUT=${3:-$ROOT/build/Release}
+MIN=11.0
+PANE=$OUT/YogaSMCPane.prefPane
+NIB=$UPSTREAM/Contents/Resources/Base.lproj/YogaSMCPane.nib
+[ -d "$NIB" ] || { echo "missing upstream nib $NIB" >&2; exit 1; }
+
+rm -rf "$PANE"
+mkdir -p "$PANE/Contents/MacOS" "$PANE/Contents/Resources/Base.lproj"
+SDK=$(xcrun --show-sdk-path)
+
+echo "  swiftc YogaSMCPane"
+swiftc -O -swift-version 5 -target "x86_64-apple-macos$MIN" -sdk "$SDK" -suppress-warnings \
+  -F "$ROOT/Frameworks" -F "$SDK/System/Library/PrivateFrameworks" \
+  -module-name YogaSMCPane -emit-executable -Xlinker -bundle \
+  -import-objc-header "$ROOT/YogaSMCUtils/YogaSMC-Bridging-Header.h" \
+  -framework AppKit -framework IOKit -framework PreferencePanes -framework OSD -framework CoreGraphics \
+  -framework ScriptingBridge \
+  "$ROOT/YogaSMCPane/YogaSMCPane.swift" "$ROOT/YogaSMCPane/GeneralSMCPane.swift" "$ROOT/YogaSMCPane/IdeaSMCPane.swift" \
+  "$ROOT/YogaSMCPane/ThinkSMCPane.swift" "$ROOT/YogaSMCPane/LegionSMCPane.swift" \
+  "$ROOT/YogaSMCUtils/OSDHelper.swift" "$ROOT/YogaSMCUtils/PropertyHelper.swift" \
+  "$ROOT/YogaSMCUtils/ScriptHelper.swift" "$ROOT/YogaSMCUtils/SystemPreferences.swift" \
+  -o "$PANE/Contents/MacOS/YogaSMCPane"
+
+sed -e 's/$(DEVELOPMENT_LANGUAGE)/en/g' -e 's/$(EXECUTABLE_NAME)/YogaSMCPane/g' \
+    -e 's/$(PRODUCT_BUNDLE_IDENTIFIER)/org.zhen.YogaSMCPane/g' -e 's/$(PRODUCT_NAME)/YogaSMCPane/g' \
+    -e 's/$(PRODUCT_BUNDLE_PACKAGE_TYPE)/BNDL/g' -e "s/\$(CURRENT_PROJECT_VERSION)/$VER/g" \
+    -e "s/\$(MARKETING_VERSION)/$VER/g" -e "s/\$(MACOSX_DEPLOYMENT_TARGET)/$MIN/g" \
+    "$ROOT/YogaSMCPane/Info.plist" > "$PANE/Contents/Info.plist"
+# upstream's "YogaSMCPane" never resolved (NSBundle fell back to the first class in the binary)
+plutil -replace NSPrincipalClass -string YogaSMCPane.YogaSMCPane "$PANE/Contents/Info.plist"
+if grep -q '\$(' "$PANE/Contents/Info.plist"; then
+  echo "unexpanded Xcode variable in Info.plist:" >&2; grep '\$(' "$PANE/Contents/Info.plist" >&2; exit 1
+fi
+cp -R "$NIB" "$PANE/Contents/Resources/Base.lproj/"
+cp "$ROOT/YogaSMCPane/YogaSMCPane.icns" "$ROOT/YogaSMCPane/General.png" "$PANE/Contents/Resources/"
+# the pane's own strings (not the app's en.lproj); unchanged upstream since 1.5.3
+cp -R "$UPSTREAM/Contents/Resources/en.lproj" "$PANE/Contents/Resources/"
+
+codesign --force -s - "$PANE" >/dev/null
+codesign --verify "$PANE"
+file "$PANE/Contents/MacOS/YogaSMCPane"
+echo "built $PANE ($VER)"
